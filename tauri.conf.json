{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex-MyStats",
  "version": "0.2.1",
  "identifier": "dev.codexusagetray.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex MyStats",
        "width": 360,
        "height": 230,
        "minWidth": 320,
        "minHeight": 230,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/usage.ico"]
  }
}

\n